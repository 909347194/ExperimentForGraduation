<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Source Han Sans CN, Microsoft YaHei, sans-serif' }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 12, background: '#1E4FA8' }} />
  <Box style={{ position: 'absolute', top: 30, left: 40, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 6, height: 34, background: '#1E4FA8' }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C' }}>适应度：为什么要排成四层，而不是加权求和</Text>
  </Box>
  <Text style={{ position: 'absolute', top: 78, left: 60, fontSize: 15, color: '#8B97A8' }}>不同性质的量不能用同一把尺子比 —— 硬约束与软偏好之间必须是「支配」关系，不是「trade-off」关系</Text>

  <Box style={{ position: 'absolute', top: 112, left: 40, width: 1200, background: '#E8EFF8', border: '1px solid #C8D6EA', borderRadius: 10, padding: '13px 20px' }}>
    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.6 }}>
      f = W<span style={{ fontSize: 11 }}>hard</span>·n<span style={{ fontSize: 11 }}>hard</span> + <span style={{ color: '#B26A00' }}>w<span style={{ fontSize: 11 }}>exc</span>·excess<span style={{ fontSize: 11 }}>m</span> + W<span style={{ fontSize: 11 }}>skip</span>·n<span style={{ fontSize: 11 }}>skip</span></span> + w<span style={{ fontSize: 11 }}>late</span>·L_tot + λ·path + w<span style={{ fontSize: 11 }}>time</span>·F<span style={{ fontSize: 11 }}>3</span>
    </Text>
  </Box>

  <Box style={{ position: 'absolute', top: 186, left: 40, width: 1200, flexDirection: 'row', gap: 14 }}>
    {[
      {
        lv: 'T0', name: '物理硬约束', color: '#B3261E', w: 'W_hard = κ·m·R_pool',
        d: '任一次违约压倒其余各层全部差异总和。κ 由量纲推导：任何作弊方案都不能靠堆叠后期收益补回。',
        judge: '不可商量',
      },
      {
        lv: 'T0.5', name: '覆盖门禁', color: '#B26A00', w: 'W_skip · n_skip',
        d: '「能装却没装」判为非法，不许与成本权衡。注意它是事后口径校验；完成语义的实际承担者是 P7 ② 的覆盖装载。',
        judge: '约束 / 非偏好',
      },
      {
        lv: 'T2', name: '迟到（软）', color: '#1E4FA8', w: 'w_late = 0.01 / 秒',
        d: '迟到可以接受，但不能免费 —— 与航程代价放在同一层做同层竞争，因此「要不要为了准时多飞一圈」由搜索自己算。',
        judge: '可权衡',
      },
      {
        lv: 'T3', name: '航程与时间', color: '#3D7BD9', w: 'λ·path + w_time·F_3',
        d: '最底层。λ 决定者在收益等价时谁胜出；F_3 = max_u T_u 取最坏机时间，避免「平均好看、单机累死」。',
        judge: '层内偏好',
      },
    ].map((c) => (
      <Box key={c.lv} style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderTop: '4px solid ' + c.color, borderRadius: 10, padding: '13px 16px', flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ background: c.color, borderRadius: 4, padding: '2px 8px' }}>
            <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#FFFFFF' }}>{c.lv}</Text>
          </Box>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0E3F8C' }}>{c.name}</Text>
        </Box>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: c.color, marginTop: 8, lineHeight: 1.4 }}>{c.w}</Text>
        <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>{c.d}</Text>
        <Box style={{ marginTop: 9, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, padding: '5px 10px' }}>
          <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: c.color }}>{c.judge}</Text>
        </Box>
      </Box>
    ))}

    <Box style={{ position: 'absolute', top: 320, left: 0, width: 1200 }}>
      <Box />
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 96, left: 40, width: 1200, flexDirection: 'row', gap: 14 }}>
    <Box style={{ flex: 1, background: '#FFF8E1', border: '1px solid #E8D9A8', borderRadius: 10, padding: '12px 20px' }}>
      <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#B26A00' }}>关键取舍：为什么不用 −m·F1 做奖励</Text>
      <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.6, marginTop: 5 }}>
        若把「被选中任务的总收益 −m·F1」放进搜索目标，搜索会倾向于<span style={{ fontWeight: 'bold' }}>删掉高收益但远的任务</span>来刷低配适值（因为「少做」也能变小）。
        本设计固定为：<span style={{ fontWeight: 'bold' }}>搜索用 f 不含 −m·F1，F1 退化为事后统计指标</span>。
      </Text>
    </Box>
    <Box style={{ flex: 1, background: '#0E3F8C', borderRadius: 10, padding: '12px 20px' }}>
      <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>层间权重不是拍脑袋，而是推导出来的</Text>
      <Text style={{ fontSize: 13, color: '#DCE7F5', lineHeight: 1.6, marginTop: 5 }}>
        κ、W<span style={{ fontSize: 10 }}>skip</span>、W<span style={{ fontSize: 10 }}>hard</span> 由各项目标的<span style={{ color: '#FFC107', fontWeight: 'bold' }}>指标上下界</span>反推，保证「下层再大的差异也翻不过上一层的 1 个单位」。层内偏好参数 λ / w<span style={{ fontSize: 10 }}>late</span> / w<span style={{ fontSize: 10 }}>time</span> 才是可调旋钮。
      </Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 44, background: '#F7F9FC', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 40px', borderTop: '1px solid #E5E7EB' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>第二阶段原理串讲 · 选择性多机巢 MUAS 是怎么被解出来的</Text>
    <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold' }}>09 / 12</Text>
  </Box>
</Slide>
