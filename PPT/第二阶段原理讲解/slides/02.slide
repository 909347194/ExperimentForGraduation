  </Box>

  <Box style={{ position: 'absolute', top: 110, left: 428, width: 812, height: 540, flexDirection: 'column', justifyContent: 'space-between' }}>
    {[
      { n: '01', t: '边界与四类决策', d: '第二阶段拿到什么、交付什么；y / x / π / z 里究竟哪些进了搜索空间', p: 'P3–P4' },
      { n: '02', t: '编码与逆映射', d: '离散三元组基因 ↔ 连续代价向量；DE 在连续空间变异，逆映射四步还原为可执行个体', p: 'P5–P6' },
      { n: '03', t: '解码修复链与终点机巢', d: '可行性不是假设出来的、是修复出来的；终点机巢由最小费用流精确配', p: 'P7–P8' },
      { n: '04', t: '适应度 · 回写 · Polish', d: '四层准字典序怎么排；修复成果如何回流种群；最后一步为什么放在搜索之外', p: 'P9–P11' },
      { n: '05', t: '闭环时序串讲', d: '一次代际里这六个环节的执行顺序与相互依赖，以及不变式清单', p: 'P12' },
