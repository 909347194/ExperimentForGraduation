  <Box style={{ position: 'absolute', top: 110, left: 40, width: 356, height: 540, background: '#0E3F8C', borderRadius: 12, padding: '44px 36px', flexDirection: 'column' }}>
    <Text style={{ fontSize: 38, fontWeight: 'bold', color: '#FFFFFF' }}>汇报提纲</Text>
