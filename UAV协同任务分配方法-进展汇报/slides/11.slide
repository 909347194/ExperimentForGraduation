<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Source Han Sans CN, Microsoft YaHei, sans-serif' }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 12, background: '#1E4FA8' }} />
  <Box style={{ position: 'absolute', top: 28, left: 40, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 6, height: 34, background: '#1E4FA8' }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C' }}>总体求解框架：分层滚动闭环</Text>
  </Box>
  <Box style={{ position: 'absolute', top: 74, left: 60, padding: '6px 18px', background: '#0E3F8C', borderRadius: 6 }}>
    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>核心主张：任务选择缩空间 → 四类决策精优化</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 112, left: 60 }}>
    <svg width={1160} height={296} viewBox='0 0 1160 296'>
      <rect x='18' y='102' width='142' height='92' rx='10' fill='#F0F5FC' stroke='#1E4FA8' strokeWidth='1.2' />
      <text x='89' y='140' font-size='16' font-weight='bold' fill='#0E3F8C' text-anchor='middle'>动态任务池</text>
      <text x='89' y='166' font-size='13' fill='#4A5568' text-anchor='middle'>滚动到达 · 滞留留池</text>
      <line x1='160' y1='148' x2='216' y2='148' stroke='#1E4FA8' strokeWidth='1.8' markerEnd='url(#ah1)' />
      <rect x='220' y='30' width='332' height='236' rx='12' fill='#FFFFFF' stroke='#1E4FA8' strokeWidth='1.2' />
      <rect x='220' y='30' width='332' height='44' rx='12' fill='#1E4FA8' />
      <rect x='220' y='58' width='332' height='16' fill='#1E4FA8' />
      <text x='386' y='58' font-size='16' font-weight='bold' fill='#FFFFFF' text-anchor='middle'>第一阶段 · 动态任务选择</text>
      <rect x='240' y='86' width='292' height='38' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='386' y='110' font-size='13.5' fill='#1A2230' text-anchor='middle'>① 优先级排序 P_i（五因素）</text>
      <rect x='240' y='130' width='292' height='38' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='386' y='154' font-size='13.5' fill='#1A2230' text-anchor='middle'>② 规模：n_cand富 / n_sel卡cap</text>
      <rect x='240' y='174' width='292' height='38' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='386' y='198' font-size='13.5' fill='#1A2230' text-anchor='middle'>③ 边际增益 Δ = ΔB / ΔC</text>
      <rect x='240' y='218' width='292' height='38' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='386' y='242' font-size='13.5' fill='#1A2230' text-anchor='middle'>两道闸门 prefilter / postcheck</text>
      <line x1='552' y1='237' x2='606' y2='237' stroke='#1E4FA8' strokeWidth='1.8' markerEnd='url(#ah1)' />
      <text x='579' y='225' font-size='13' font-weight='bold' fill='#1E4FA8' text-anchor='middle'>选择集</text>
      <rect x='610' y='30' width='332' height='236' rx='12' fill='#FFFFFF' stroke='#1E4FA8' strokeWidth='1.2' />
      <rect x='610' y='30' width='332' height='44' rx='12' fill='#0E3F8C' />
      <rect x='610' y='58' width='332' height='16' fill='#0E3F8C' />
      <text x='776' y='58' font-size='16' font-weight='bold' fill='#FFFFFF' text-anchor='middle'>第二阶段 · 选择性 MUAS</text>
      <rect x='630' y='90' width='292' height='44' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='776' y='118' font-size='14' fill='#1A2230' text-anchor='middle'>统一编码 + DMDE 进化搜索</text>
      <line x1='776' y1='134' x2='776' y2='148' stroke='#3D7BD9' strokeWidth='1.2' markerEnd='url(#ah2)' />
      <rect x='630' y='148' width='292' height='44' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='776' y='176' font-size='14' fill='#1A2230' text-anchor='middle'>解码 + 可行性修复（Lamarckian 回写）</text>
      <line x1='776' y1='192' x2='776' y2='206' stroke='#3D7BD9' strokeWidth='1.2' markerEnd='url(#ah2)' />
      <rect x='630' y='206' width='292' height='44' rx='7' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.8' />
      <text x='776' y='234' font-size='14' fill='#1A2230' text-anchor='middle'>终点机巢：最小费用流精确求解</text>
