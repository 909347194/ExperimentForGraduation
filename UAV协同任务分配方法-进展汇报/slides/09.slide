  <Box style={{ position: 'absolute', bottom: 58, left: 80, flexDirection: 'row', gap: 12, alignItems: 'center' }}>
    {['01', '02', '03'].map((n, i) => (
      <Box key={n} style={{ padding: '6px 16px', borderRadius: 14, background: i === 2 ? '#1E4FA8' : '#F0F5FC' }}>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: i === 2 ? '#FFFFFF' : '#8B97A8' }}>{n}</Text>
      </Box>
